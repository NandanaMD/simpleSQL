# Server Configuration
NODE_ENV=development
SERVER_PORT=3000
SERVER_HOST=localhost

# Query Configuration
QUERY_TIMEOUT_MS=30000
MAX_RESULT_ROWS=10000
BATCH_INSERT_SIZE=1000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Database (SQLite for config storage)
CONFIG_DB_PATH=./config/connections.db

# CSV Import
MAX_CSV_SIZE_MB=100
CSV_SAMPLE_ROWS=100
