{
  "name": "sql-ide",
  "version": "1.0.0",
  "description": "Production-grade local desktop SQL IDE for PostgreSQL",
  "main": "dist/electron/main.js",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "client",
    "server",
    "electron",
    "shared"
  ],
  "scripts": {
    "_postinstall": "electron-builder install-app-deps",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:electron": "cd electron && npm run dev",
    "dev": "concurrently -n \"server,client,electron\" -c \"blue,magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build:electron": "cd electron && npm run build",
    "build": "npm run build:server && npm run build:client && npm run build:electron",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "build": {
    "appId": "com.sqlide.app",
    "productName": "SQL IDE",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/dist",
        "to": "server"
      },
      {
        "from": "client/dist",
        "to": "client"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Development"
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "keywords": [
    "sql",
    "postgresql",
    "ide",
    "electron",
    "database"
  ],
  "author": "SQL IDE",
  "license": "MIT"
}
